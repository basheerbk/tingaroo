---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupForm from '../../components/SignupForm.astro';
import { DONATION_URL, GRADE_BANDS, formatDate } from '../../consts';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => import.meta.env.DEV || !data.draft);

  return lessons.map((lesson) => {
    const next = lessons
      .filter((other) => other.data.unit === lesson.data.unit && other.data.lessonNumber > lesson.data.lessonNumber)
      .sort((a, b) => a.data.lessonNumber - b.data.lessonNumber)[0];
    return { params: { slug: lesson.id }, props: { lesson, next } };
  });
}

interface Props {
  lesson: CollectionEntry<'lessons'>;
  next?: CollectionEntry<'lessons'>;
}

const { lesson, next } = Astro.props;
const data = lesson.data;
const band = GRADE_BANDS[data.gradeBand];
const { Content } = await render(lesson);
---
<BaseLayout
  title={`${data.title} | Tingaroo`}
  description={`${band.name} lesson for ${band.grades.toLowerCase()}, ages ${data.ageRange}. Takes about ${data.minutes} minutes.`}
  ogType="article"
  lastUpdated={data.updated}
>
  <article class="container container-narrow lesson">
    <header class="lesson-header">
      <p class={`tag ${band.tagClass}`}>{band.name} · {band.grades}</p>
      <h1>{data.title}</h1>
      <p class="lesson-unit">{data.unit} · Lesson {data.lessonNumber}</p>
    </header>

    <dl class="lesson-meta">
      <div>
        <dt>Time</dt>
        <dd>{data.minutes} minutes</dd>
      </div>
      <div>
        <dt>Ages</dt>
        <dd>{data.ageRange}</dd>
      </div>
      <div>
        <dt>Materials</dt>
        <dd>
          <ul>
            {data.materials.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
    </dl>

    <section class="lesson-section helper-box" aria-labelledby="helper-title">
      <h2 id="helper-title">Parent helper</h2>
      <p>{data.parentHelper.overview}</p>
      <h3>When they get stuck, try saying</h3>
      <ul>
        {data.parentHelper.whenStuck.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <section class="lesson-section" aria-labelledby="tutorial-title">
      <h2 id="tutorial-title">Step-by-step tutorial</h2>
      <div class="prose">
        <Content />
      </div>
    </section>

    <section class="lesson-section" aria-labelledby="downloads-title">
      <h2 id="downloads-title">Downloads</h2>
      {data.sb3File || data.pdfFile ? (
        <ul class="download-list">
          {data.sb3File && <li><a href={data.sb3File} download>Finished project file (.sb3)</a></li>}
          {data.pdfFile && <li><a href={data.pdfFile} download>Printable lesson pack (PDF)</a></li>}
        </ul>
      ) : (
        <p>Downloads for this lesson are not ready yet.</p>
      )}
    </section>

    <section class="lesson-section" aria-labelledby="plan-title">
      <h2 id="plan-title">Lesson plan</h2>
      <h3>Goals</h3>
      <ul>
        {data.lessonPlan.goals.map((goal) => <li>{goal}</li>)}
      </ul>
      <h3>Timing</h3>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr><th scope="col">Part</th><th scope="col">Minutes</th><th scope="col">What happens</th></tr>
          </thead>
          <tbody>
            {data.lessonPlan.phases.map((phase) => (
              <tr><th scope="row">{phase.name}</th><td>{phase.minutes}</td><td>{phase.activity}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="lesson-section" aria-labelledby="worksheet-title">
      <h2 id="worksheet-title">Worksheet and challenge cards</h2>
      <h3>Worksheet prompts</h3>
      <ol>
        {data.worksheet.prompts.map((prompt) => <li>{prompt}</li>)}
      </ol>
      <h3>Challenge cards for fast finishers</h3>
      <ul>
        {data.worksheet.challengeCards.map((card) => <li>{card}</li>)}
      </ul>
    </section>

    <section class="lesson-section" aria-labelledby="rubric-title">
      <h2 id="rubric-title">Rubric and answer key</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr><th scope="col">The project must</th><th scope="col">What to look for</th></tr>
          </thead>
          <tbody>
            {data.rubric.map((row) => (
              <tr><th scope="row">{row.criterion}</th><td>{row.lookFor}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3>Answer key</h3>
      <ol>
        {data.answerKey.map((answer) => <li>{answer}</li>)}
      </ol>
    </section>

    <section class="lesson-section" aria-labelledby="standards-title">
      <h2 id="standards-title">Standards</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr><th scope="col">Framework</th><th scope="col">Code</th><th scope="col">Description</th></tr>
          </thead>
          <tbody>
            {data.standards.length > 0 ? (
              data.standards.map((standard) => (
                <tr><td>{standard.framework}</td><td>{standard.code}</td><td>{standard.description}</td></tr>
              ))
            ) : (
              <tr><td colspan="3">Standards for this lesson have not been added yet.</td></tr>
            )}
          </tbody>
        </table>
      </div>
    </section>

    <p class="lesson-updated">Last updated {formatDate(data.updated)}</p>

    <p class="next-lesson">
      {next ? (
        <a href={`/lessons/${next.id}/`}>Next lesson: {next.data.title}</a>
      ) : (
        <a href="/#grades">Back to all projects</a>
      )}
    </p>

    <section class="lesson-section lesson-signup" aria-labelledby="signup-title">
      <h2 id="signup-title">Get project tips by email</h2>
      <SignupForm id="lesson" label="Your email address" buttonLabel="Sign me up" />
    </section>

    <section class="lesson-section" aria-labelledby="support-title">
      <h2 id="support-title">Support Tingaroo</h2>
      <p>Tingaroo is free. If this lesson helped you, you can help fund the next one: {DONATION_URL ? <a href={DONATION_URL}>Donate to Tingaroo</a> : '[DONATION LINK]'}</p>
    </section>
  </article>
</BaseLayout>
